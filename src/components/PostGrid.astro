---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BlogSidebar from "./BlogSidebar.astro";
import { categoryLabel } from "../lib/categories";
import { isoDay } from "../lib/format";

interface Props {
  posts: CollectionEntry<"posts">[];
  active?: string;
}

const { posts, active } = Astro.props;
const PAGE_SIZE = 30;
---

<div class="py-8">
  <h1 class="font-display mb-8 text-xl tracking-wider uppercase">
    {active ? categoryLabel(active) : "Archivo"}
  </h1>

  <div class="grid grid-cols-1 gap-8 md:grid-cols-[240px_1fr]">
    <BlogSidebar active={active} />

    <div>
      {
        posts.length === 0 && (
          <p class="text-muted">Todavía no hay entradas aquí.</p>
        )
      }

      <div
        id="posts-grid"
        data-page-size={PAGE_SIZE}
        class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
      >
        {
          posts.map((post, index) => (
            <article
              class:list={[
                "post-card group flex flex-col",
                { hidden: index >= PAGE_SIZE },
              ]}
            >
              <a href={`/blog/${post.id}`} class="block">
                <div class="bg-surface mb-3 aspect-video overflow-hidden">
                  <Image
                    src={post.data.thumb}
                    alt={post.data.thumbAlt || post.data.title}
                    widths={[240, 480, 720]}
                    sizes="(min-width: 1024px) 240px, (min-width: 768px) 220px, (min-width: 640px) 50vw, 100vw"
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                </div>
                <h2 class="font-display group-hover:text-accent mb-1 text-sm leading-snug font-medium transition-colors">
                  {post.data.title}
                </h2>
              </a>

              <div class="text-muted flex items-center gap-2 text-[11px]">
                <time datetime={isoDay(post.data.date)}>
                  {isoDay(post.data.date)}
                </time>
                <span>·</span>
                <span class="uppercase">{categoryLabel(post.data.category)}</span>
              </div>
            </article>
          ))
        }
      </div>

      {
        posts.length > PAGE_SIZE && (
          <div
            id="load-more-container"
            class="mt-12 flex flex-col items-center pt-8"
          >
            <button
              id="load-more-btn"
              type="button"
              class="group flex cursor-pointer flex-col items-center gap-2 focus:outline-none"
            >
              <span class="border-line group-hover:border-accent group-hover:text-accent flex h-14 w-14 items-center justify-center rounded-full border transition-colors">
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                >
                  <line x1="12" y1="5" x2="12" y2="19" />
                  <line x1="5" y1="12" x2="19" y2="12" />
                </svg>
              </span>
              <span class="font-display text-muted group-hover:text-fg text-xs tracking-wider uppercase transition-colors">
                Ver más entradas
              </span>
            </button>
          </div>
        )
      }
    </div>
  </div>
</div>

<script>
  const grid = document.getElementById("posts-grid");
  const button = document.getElementById("load-more-btn");
  const container = document.getElementById("load-more-container");
  const pageSize = Number(grid?.dataset.pageSize ?? 30);
  const hidden = Array.from(
    document.querySelectorAll<HTMLElement>(".post-card.hidden"),
  );

  button?.addEventListener("click", () => {
    hidden.splice(0, pageSize).forEach((el) => el.classList.remove("hidden"));
    if (hidden.length === 0) container?.classList.add("hidden");
  });
</script>