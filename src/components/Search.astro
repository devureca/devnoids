<button
  type="button"
  id="search-open"
  aria-label="Buscar"
  aria-haspopup="dialog"
  class="hover:text-accent p-1"
>
  <svg
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
  >
    <circle cx="10" cy="10" r="6.5"></circle>
    <path d="M15 15l6 6"></path>
  </svg>
</button>

<dialog
  id="search-dialog"
  aria-label="Buscar en el sitio"
  class="m-0 h-dvh max-h-none w-dvw max-w-none items-center justify-center border-0 bg-neutral-900/90 p-0 open:flex"
>
  <div class="relative w-full max-w-[720px] px-4">
    <button
      type="button"
      id="search-close"
      aria-label="Cerrar búsqueda"
      class="absolute -top-12 right-4 p-1 text-white hover:text-white/70"
    >
      <svg
        width="26"
        height="26"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
      >
        <path d="M5 5l14 14M19 5L5 19"></path>
      </svg>
    </button>

    <form action="/search" method="get" role="search" class="flex">
      <input
        id="search-input"
        type="search"
        name="q"
        required
        autocomplete="off"
        placeholder="Escribe para buscar entradas..."
        class="h-12 min-w-0 flex-1 rounded-l bg-white px-4 text-neutral-900 outline-none placeholder:text-neutral-500"
      />
      <button
        type="submit"
        aria-label="Buscar"
        class="bg-accent flex h-12 w-14 items-center justify-center rounded-r text-white"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
        >
          <circle cx="10" cy="10" r="6.5"></circle>
          <path d="M15 15l6 6"></path>
        </svg>
      </button>
    </form>
  </div>
</dialog>

<script>
  const dialog = document.getElementById("search-dialog") as HTMLDialogElement;
  const input = document.getElementById("search-input") as HTMLInputElement;
  const openBtn = document.getElementById("search-open");
  const closeBtn = document.getElementById("search-close");

  const open = () => {
    if (dialog.open) return;
    dialog.showModal();
    input.focus();
    input.select();
  };

  openBtn?.addEventListener("click", open);
  closeBtn?.addEventListener("click", () => dialog.close());

  dialog.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });

  document.addEventListener("keydown", (event) => {
    const target = event.target as HTMLElement;
    const typing =
      target.tagName === "INPUT" ||
      target.tagName === "TEXTAREA" ||
      target.isContentEditable;

    if (event.key === "/" && !typing && !event.metaKey && !event.ctrlKey) {
      event.preventDefault();
      open();
    }
  });
</script>