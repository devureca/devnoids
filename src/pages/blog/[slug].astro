---
import { render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { categoryLabel } from "../../lib/categories";
import { isoDay, longDate } from "../../lib/format";
import { getPublishedPosts } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, category, tags, cover, coverAlt } = post.data;
---

<BaseLayout title={title} description={description}>
  <nav aria-label="Migas de pan" class="font-display text-muted py-6 text-xs">
    <a href="/" class="hover:text-accent">devnoids</a>
    <span class="mx-1">›</span>
    <a href="/blog" class="hover:text-accent">Blog</a>
    <span class="mx-1">›</span>
    <span class="text-fg">{title}</span>
  </nav>

  <article>
    <header class="py-6 text-center">
      <h1
        class="font-display text-3xl font-medium tracking-[0.12em] uppercase md:text-5xl"
      >
        {title}
      </h1>
      <p class="font-display mt-4 text-xs uppercase">
        <time datetime={isoDay(date)}>{longDate(date)}</time>
        ·
        <a href={`/blog/categoria/${category}`} class="text-accent underline">
          {categoryLabel(category)}
        </a>
      </p>
    </header>

    {
      cover && (
        <Image
          src={cover}
          alt={coverAlt || title}
          widths={[640, 1080, 1600]}
          sizes="(min-width: 1080px) 1080px, 100vw"
          loading="eager"
          fetchpriority="high"
          class="w-full"
        />
      )
    }

    <div class="prose mx-auto mt-8 max-w-180">
      <Content />
    </div>

    {
      tags.length > 0 && (
        <ul
          class="font-display mx-auto mt-10 flex max-w-180 flex-wrap gap-2 text-xs uppercase"
        >
          {tags.map((tag) => (
            <li class="bg-surface px-2 py-1">{tag}</li>
          ))}
        </ul>
      )
    }
  </article>
</BaseLayout>